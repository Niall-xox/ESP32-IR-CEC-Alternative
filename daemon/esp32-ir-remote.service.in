# Template — CMake substitutes @CMAKE_INSTALL_FULL_BINDIR@ at configure time and
# writes the result into the build directory. Edit this file, never the
# generated one. Hardcoding the path here would be wrong for at least one of the
# two prefixes in play: /usr/local for a hand `cmake --install`, /usr for a
# distribution package.

[Unit]
Description=ESP32 IR Remote Daemon
# Must start after logind is running — we connect to it over D-Bus at startup.
# dbus.socket is ordered explicitly too: without it the daemon can win the race
# against the system bus at boot, fail to connect, exit 1, and only recover on
# the next Restart= attempt — turning the TV on several seconds late.
After=dbus.socket systemd-logind.service
Requires=systemd-logind.service

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/esp32-ir-daemon
# Restart on unexpected exit (e.g. serial port disconnected).
# Does not restart on clean exit (e.g. systemd stopping the service for shutdown).
Restart=on-failure
RestartSec=5

# Run unprivileged. The daemon only needs to open the ESP32's /dev/hidraw node
# and talk to logind on the system bus — neither requires root once
# 99-esp32-ir-remote.rules has granted the esp32ir group access to the device.
# The account is created by packaging/postinst when installed from a package,
# or by hand per the install steps in the brief.
User=esp32ir
Group=esp32ir

# --- Sandboxing ---
# The daemon reads no files, writes nothing, and makes no network connections,
# so almost everything can be closed off. If the daemon ever fails to reach
# D-Bus after a change here, ProtectSystem is the first directive to relax.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
# AF_UNIX is required for the D-Bus system bus socket. No other family is used.
RestrictAddressFamilies=AF_UNIX
# Setting DeviceAllow implies DevicePolicy=closed, restricting the daemon to
# hidraw plus the standard pseudo-devices (null, zero, random, urandom, tty).
DeviceAllow=char-hidraw rw

[Install]
# Start automatically when the system reaches the normal multi-user state
WantedBy=multi-user.target
