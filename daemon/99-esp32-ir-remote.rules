# udev rule — grants the esp32ir group access to the ESP32 IR Remote.
#
# /dev/hidraw* nodes are root-only by default, which is the only reason the
# daemon previously needed to run as root. This rule hands ownership of just
# this one device to a dedicated group, so the daemon can run unprivileged.
#
# The idVendor/idProduct values must match DEVICE_VID/DEVICE_PID in both
# firmware/src/main.cpp and daemon/src/main.cpp. They are lowercase hex without
# the 0x prefix — update all three together when a registered VID/PID is
# assigned.
#
# Install:
#   sudo groupadd --system esp32ir
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin -g esp32ir esp32ir
#   sudo cp 99-esp32-ir-remote.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Verify (with the device plugged in):
#   ls -l /dev/hidraw*        # the ESP32's node should show group esp32ir
#
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1234", ATTRS{idProduct}=="5678", GROUP="esp32ir", MODE="0660"
